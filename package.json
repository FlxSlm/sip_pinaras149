    "@vercel/blob": "^2.8.1",
    "heic-to": "^1.6.6",
    "next": "16.3.8",
    "next-auth": "^4.24.15",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
