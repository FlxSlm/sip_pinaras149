generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  WARGA
  ADMIN_KELURAHAN
}

enum ComplaintStatus {
  MENUNGGU
  DIPROSES
  SELESAI
  DITOLAK
}

enum ComplaintPriority {
  NORMAL
  PERLU_PERHATIAN
}

enum ComplaintAction {
  CREATED
  OPENED
  STATUS_CHANGED
  PRIORITY_CHANGED
  RESPONSE_ADDED
  NOTE_ADDED
}

enum NotificationType {
  COMPLAINT_RECEIVED
  COMPLAINT_UPDATED
  ANNOUNCEMENT_PUBLISHED
}

enum AnnouncementMediaType {
  TEXT
  PDF
  VIDEO
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id            String         @id @default(cuid())
  username      String?        @unique
  name          String?
  email         String?        @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          UserRole       @default(WARGA)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  accounts      Account[]
  sessions      Session[]
  complaints    Complaint[]    @relation("ComplaintReporter")
  complaintLogs ComplaintLog[] @relation("ComplaintLogActor")
  announcements Announcement[] @relation("AnnouncementCreator")
  notifications Notification[]

  @@index([role])
}

model Lingkungan {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Complaint {
  id               String            @id @default(cuid())
  reporterUserId   String
  ticketNumber     String            @unique
  title            String
  category         String
  description      String
  location         String?
  status           ComplaintStatus   @default(MENUNGGU)
  priority         ComplaintPriority?
  internalNote     String?
  officialResponse String?
  respondedAt      DateTime?
  openedAt         DateTime?
  completedAt      DateTime?
  rejectedAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  reporter         User              @relation("ComplaintReporter", fields: [reporterUserId], references: [id], onDelete: Restrict)
  logs             ComplaintLog[]
  evidences        ComplaintEvidence[]
  notifications    Notification[]

  @@index([reporterUserId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

model ComplaintEvidence {
  id          String    @id @default(cuid())
  complaintId String
  path        String
  mimeType    String
  sizeBytes   Int
  createdAt   DateTime  @default(now())
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId])
}

model ComplaintLog {
  id          String             @id @default(cuid())
  complaintId String
  actorUserId String?
  action      ComplaintAction
  fromStatus  ComplaintStatus?
  toStatus    ComplaintStatus?
  oldPriority ComplaintPriority?
  newPriority ComplaintPriority?
  note        String?
  createdAt   DateTime           @default(now())
  complaint   Complaint          @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  actor       User?              @relation("ComplaintLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([complaintId])
  @@index([actorUserId])
  @@index([createdAt])
}

model Announcement {
  id          String               @id @default(cuid())
  title       String
  slug        String               @unique
  content     String
  mediaType   AnnouncementMediaType @default(TEXT)
  mediaRef    String?
  isPinned    Boolean              @default(false)
  status      AnnouncementStatus   @default(DRAFT)
  publishedAt DateTime?
  createdById String
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  createdBy   User                 @relation("AnnouncementCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([createdById])
}

model Notification {
  id             String           @id @default(cuid())
  recipientId    String
  type           NotificationType
  title          String
  message        String
  complaintId    String?
  announcementId String?
  readAt         DateTime?
  createdAt      DateTime         @default(now())
  recipient      User             @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  complaint      Complaint?       @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([recipientId, readAt, createdAt])
  @@index([complaintId])
  @@index([announcementId])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model TicketSequence {
  periodKey    String   @id
  currentValue Int      @default(0)
  updatedAt    DateTime @updatedAt
}

model SiteContent {
  key        String   @id
  value      Json
  updatedAt  DateTime @updatedAt
  updatedById String?
}

model Statistic {
  id          String   @id @default(cuid())
  label       String
  value       String
  unit        String?
  source      String
  sourceYear  String?
  sourcePage  String?
  verifiedAt  DateTime?
  sortOrder   Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Potential {
  id          String   @id @default(cuid())
  title       String
  description String
  imageRef    String?
  sortOrder   Int      @default(0)
  published   Boolean  @default(true)
  sourceNote  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Facility {
  id          String   @id @default(cuid())
  name        String
  category    String
  description String?
  address     String?
  imageRef    String?
  published   Boolean  @default(true)
  sourceNote  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GalleryMedia {
  id          String   @id @default(cuid())
  storageKey  String
  mimeType    String
  sizeBytes   Int
  caption     String?
  credit      String?
  category    String?
  sortOrder   Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
}
