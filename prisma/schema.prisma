generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  warga
  kepala_lingkungan
  lurah
}

enum HandlingStatus {
  DIAJUKAN
  DIVERIFIKASI
  DITERUSKAN_KE_LURAH
  DALAM_PROSES
  SELESAI
  DI_LUAR_KEWENANGAN
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
}

enum ComplaintAction {
  CREATED
  VERIFIED
  FORWARDED_TO_LURAH
  INTERNAL_NOTE_ADDED
  STATUS_CHANGED
  RESPONSE_ADDED
  PUBLISHED
  UNPUBLISHED
  RATED
}

enum NotificationType {
  COMPLAINT_RECEIVED
  COMPLAINT_UPDATED
  ANNOUNCEMENT_PUBLISHED
}

model User {
  id            String         @id @default(cuid())
  username      String         @unique
  name          String?
  email         String?        @unique
  emailVerified DateTime?
  image         String?
  phone         String?
  passwordHash  String?
  role          UserRole       @default(warga)
  lingkunganId  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  lingkungan    Lingkungan?    @relation(fields: [lingkunganId], references: [id], onDelete: SetNull)
  accounts      Account[]
  sessions      Session[]
  complaints    Complaint[]    @relation("ComplaintReporter")
  complaintLogs ComplaintLog[] @relation("ComplaintLogActor")
  announcements Announcement[] @relation("AnnouncementCreator")
  notifications Notification[]

  @@index([role])
  @@index([lingkunganId])
}

model Lingkungan {
  id         String      @id @default(cuid())
  name       String
  code       String      @unique
  active     Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  users      User[]
  complaints Complaint[]
}

model Complaint {
  id                String            @id @default(cuid())
  reporterUserId    String
  lingkunganId      String
  ticketNumber      String            @unique
  title             String
  category          String
  description       String
  evidencePath      String?
  handlingStatus    HandlingStatus    @default(DIAJUKAN)
  internalNote      String?
  officialResponse  String?
  respondedAt       DateTime?
  rating            Int?
  ratedAt           DateTime?
  publicationStatus PublicationStatus @default(DRAFT)
  publishedAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  reporter          User              @relation("ComplaintReporter", fields: [reporterUserId], references: [id], onDelete: Restrict)
  lingkungan        Lingkungan        @relation(fields: [lingkunganId], references: [id], onDelete: Restrict)
  logs              ComplaintLog[]
  evidences         ComplaintEvidence[]
  notifications     Notification[]

  @@index([reporterUserId])
  @@index([lingkunganId])
  @@index([handlingStatus])
  @@index([publicationStatus])
  @@index([createdAt])
}

model ComplaintEvidence {
  id          String    @id @default(cuid())
  complaintId String
  path        String
  mimeType    String
  sizeBytes   Int
  createdAt   DateTime  @default(now())
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId])
}

model ComplaintLog {
  id          String          @id @default(cuid())
  complaintId String
  actorUserId String?
  action      ComplaintAction
  fromStatus  HandlingStatus?
  toStatus    HandlingStatus?
  note        String?
  createdAt   DateTime        @default(now())
  complaint   Complaint       @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  actor       User?           @relation("ComplaintLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([complaintId])
  @@index([actorUserId])
  @@index([createdAt])
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String
  pdfPath     String?
  isPinned    Boolean  @default(false)
  published   Boolean  @default(false)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User     @relation("AnnouncementCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([published])
  @@index([createdById])
}

model Notification {
  id             String           @id @default(cuid())
  recipientId    String
  type           NotificationType
  title          String
  message        String
  complaintId    String?
  announcementId String?
  readAt         DateTime?
  createdAt      DateTime         @default(now())
  recipient      User             @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  complaint      Complaint?       @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([recipientId, readAt, createdAt])
  @@index([complaintId])
  @@index([announcementId])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model TicketSequence {
  periodKey    String   @id
  currentValue Int      @default(0)
  updatedAt    DateTime @updatedAt
}
